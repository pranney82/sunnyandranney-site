---
export const prerender = false;

import AdminBase from '@/layouts/AdminBase.astro';
import { liveGusto } from '@/lib/gusto/client.mjs';
import { GustoError } from '@/lib/gusto/oauth.mjs';
import { draftPayrolls, loadHandEntry } from '@/lib/gusto/send.mjs';
import { localDate } from '@/lib/time-clock/hours.mjs';

if (Astro.locals.admin?.role !== 'manager') return new Response('Not authorized', { status: 403 });

const env = Astro.locals.runtime.env;
const gusto = await liveGusto(env);

interface DraftPayroll {
  uuid: string;
  start: string;
  end: string;
}

let payrolls: DraftPayroll[] = [];
let selected: DraftPayroll | undefined;
let summary: Awaited<ReturnType<typeof loadHandEntry>> | undefined;
let gustoProblem = '';

if (gusto.client) {
  try {
    payrolls = await draftPayrolls(gusto.client, localDate(new Date().toISOString()));
    const wanted = Astro.url.searchParams.get('payroll');
    selected = payrolls.find((payroll) => payroll.uuid === wanted) ?? (payrolls.length === 1 ? payrolls[0] : undefined);
    if (selected) summary = await loadHandEntry(env.DB, selected);
  } catch (err) {
    if (!(err instanceof GustoError)) throw err;
    gustoProblem = err.message;
  }
}

const dateLabel = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });
const day = (date: string) => dateLabel.format(new Date(`${date}T00:00:00Z`));
const hours = (minutes: number) => (minutes / 60).toFixed(2);
---

<AdminBase title="Hours for Gusto">
  <div class="page-header">
    <div>
      <h1>Hours for Gusto</h1>
      <p class="muted">Type these approved hours into the draft payroll in Gusto, then review and run payroll there.</p>
    </div>
  </div>

  {gustoProblem && <p class="notice">Could not reach Gusto. {gustoProblem}</p>}

  {!gusto.client && <div class="card empty">Gusto is not connected, so pay periods can't be shown yet.</div>}

  {gusto.client && !gustoProblem && payrolls.length === 0 && (
    <div class="card empty">Gusto has no draft payroll open right now.</div>
  )}

  {payrolls.length > 1 && !selected && (
    <section class="card">
      <h2>Choose a pay period</h2>
      <ul class="periods">
        {payrolls.map((payroll) => (
          <li><a href={`?payroll=${encodeURIComponent(payroll.uuid)}`}>{day(payroll.start)} to {day(payroll.end)}</a></li>
        ))}
      </ul>
    </section>
  )}

  {selected && summary && (
    <section class="card">
      <h2>Pay period {day(selected.start)} to {day(selected.end)}</h2>

      {summary.blockers.length > 0 && (
        <div class="notice" id="hours-blockers">
          <p>These shifts aren't counted yet. Finish them before typing anything into Gusto.</p>
          <ul>{summary.blockers.map((blocker: string) => <li>{blocker}</li>)}</ul>
        </div>
      )}

      {summary.people.length === 0 && summary.blockers.length === 0 && <p class="muted">No approved hours in this pay period.</p>}

      {summary.people.length > 0 && (
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Employee</th>
                <th class="num">Shifts</th>
                <th class="num">Regular</th>
                <th class="num">Overtime</th>
              </tr>
            </thead>
            <tbody>
              {summary.people.map((person) => (
                <tr>
                  <td>{person.name}</td>
                  <td class="num">{person.shifts}</td>
                  <td class="num">{hours(person.regularMinutes)}</td>
                  <td class="num">{hours(person.overtimeMinutes)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <p class="muted reminder">Check anyone not listed here on the draft payroll too. Gusto can fill in default hours for them.</p>
    </section>
  )}
</AdminBase>

<style>
  h2 { font-size: 1.0625rem; margin-bottom: 0.5rem; }
  .periods { list-style: none; display: grid; gap: 0.375rem; }
  #hours-blockers { margin-bottom: 0.75rem; }
  #hours-blockers ul { margin: 0.375rem 0 0 1.25rem; }
  .reminder { margin-top: 0.75rem; }
</style>

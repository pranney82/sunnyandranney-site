---
export const prerender = false;

import AdminBase from '@/layouts/AdminBase.astro';
import SendPlan from '@/components/admin/SendPlan.astro';
import { svg } from '@/lib/admin-ui';
import { liveGusto } from '@/lib/gusto/client.mjs';

const admin = Astro.locals.admin;
if (admin?.role !== 'manager') return new Response('Not authorized', { status: 403 });

const gusto = await liveGusto(Astro.locals.runtime.env);
if (gusto.readOnly) return Astro.redirect('/admin/hours/for-gusto/');
// Through Gusto's MCP server, hours go into Gusto's own time tracking, which
// payroll reads. Through the partner API they're time sheets synced onto the draft.
const intoTimeTracking = gusto.client?.route === 'mcp';
// With the payroll permission too, the admin also sets the hours on the draft payroll.
const fillsPayroll = Boolean(gusto.client?.fillsPayroll);
---

<AdminBase title="Send to Gusto">
  <div class="page-header">
    <div>
      <h1>Send to Gusto</h1>
      <p class="muted">
        {fillsPayroll
          ? "Approved hours go into Gusto's time tracking and onto the draft payroll. Nobody is paid until someone submits payroll in Gusto."
          : intoTimeTracking
            ? "Approved hours go into Gusto's time tracking for the pay period. Nobody is paid until someone runs payroll in Gusto."
            : 'Approved hours go onto the draft payroll. You still review and run payroll in Gusto.'}
      </p>
    </div>
  </div>

  {!gusto.client && (
    <div class="card empty">
      <div class="empty-icon"><Fragment set:html={svg('gusto', 24)} /></div>
      <h2>Gusto isn't connected</h2>
      <p>Connect it to send approved hours straight onto the payroll.</p>
      {admin.owner && (
        <div class="empty-actions">
          <a class="btn btn-primary" href="/admin/gusto/"><Fragment set:html={svg('gusto', 18)} />Connect Gusto</a>
        </div>
      )}
    </div>
  )}

  {gusto.client && (
    <div class="stream">
      <div class="card skeleton" aria-busy="true" aria-label="Loading the pay period from Gusto">
        <span class="sk sk-title"></span>
        <span class="sk sk-line"></span>
        <span class="sk sk-row"></span>
        <span class="sk sk-row"></span>
        <span class="sk sk-row"></span>
      </div>
      <SendPlan client={gusto.client} intoTimeTracking={intoTimeTracking} fillsPayroll={fillsPayroll} />
    </div>
  )}
</AdminBase>

<script>
  import { sendToGusto } from '@/lib/admin/send-client';
  import { toast } from '@/lib/admin/shell';

  const card = document.querySelector<HTMLElement>('#send-card');
  const button = document.querySelector<HTMLButtonElement>('#send-button');
  const result = document.querySelector<HTMLElement>('#send-result');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    const label = button.innerHTML;
    const outcome = await sendToGusto(card!.dataset.payroll!, (sent) => {
      button.textContent = sent ? `Sending… ${sent} sent` : 'Sending…';
    });
    if (!outcome.ok) {
      button.innerHTML = label;
      button.disabled = false;
      toast(outcome.message, 'error');
      return;
    }
    button.hidden = true;
    result!.textContent = outcome.message;
    if (outcome.problems) toast(`Check in Gusto: ${outcome.problems}`, 'error');
    else toast(outcome.sent ? `Sent ${outcome.sent} ${outcome.sent === 1 ? 'shift' : 'shifts'} to Gusto` : 'Nothing new to send');
  });
</script>

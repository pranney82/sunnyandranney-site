---
export const prerender = false;

import AdminBase from '@/layouts/AdminBase.astro';
import { STORE_TIME_ZONE } from '@/lib/time-clock/hours.mjs';
import { listStaff, openShiftsByStaff } from '@/lib/time-clock/store';
import { initials, svg, tone } from '@/lib/admin-ui';

if (!Astro.locals.admin) return new Response('Not authorized', { status: 403 });

const db = Astro.locals.runtime.env.DB;
const [staff, openShifts] = await Promise.all([listStaff(db, true), openShiftsByStaff(db)]);

const formatTime = new Intl.DateTimeFormat('en-US', {
  timeZone: STORE_TIME_ZONE,
  weekday: 'short',
  hour: 'numeric',
  minute: '2-digit',
});

const people = staff.map((person) => {
  const openSince = openShifts.get(person.id);
  return {
    id: person.id,
    name: person.display_name,
    canClock: Boolean(person.pin_hash),
    openSince: openSince ? formatTime.format(new Date(openSince)) : null,
  };
});
---

<AdminBase title="Time clock">
  <div class="page-header">
    <div>
      <h1>Time clock</h1>
      <p class="muted">Tap your name, then enter your PIN.</p>
    </div>
    <p class="clock-now" id="clock-now" aria-hidden="true"></p>
  </div>

  <p id="clock-result" class="clock-result" role="status" aria-live="polite"></p>

  {
    people.length === 0 ? (
      <div class="card empty">
        <div class="empty-icon"><Fragment set:html={svg('clock', 24)} /></div>
        <h2>Nobody is on the time clock yet</h2>
        <p>Turn people on and give them a PIN on the Staff page, and they'll appear here.</p>
        {Astro.locals.admin?.role === 'manager' && (
          <div class="empty-actions">
            <a class="btn" href="/admin/staff/"><Fragment set:html={svg('staff', 18)} />Staff</a>
          </div>
        )}
      </div>
    ) : (
      <div class="clock-grid">
        {people.map((person) => (
          <button
            type="button"
            class="clock-person"
            data-id={person.id}
            data-name={person.name}
            data-action={person.openSince ? 'out' : 'in'}
            disabled={!person.canClock}
          >
            <span class="avatar clock-avatar" data-tone={tone(person.name)}>{initials(person.name)}</span>
            <span class="clock-name">{person.name}</span>
            {person.openSince ? (
              <span class="badge badge-open">In since {person.openSince}</span>
            ) : (
              <span class="badge">{person.canClock ? 'Clocked out' : 'Needs a PIN'}</span>
            )}
          </button>
        ))}
      </div>
    )
  }

  <dialog id="pin-dialog" aria-labelledby="pin-title">
    <form id="pin-form">
      <h2 id="pin-title"></h2>
      <p id="pin-error" class="form-error" role="alert"></p>
      <div class="field">
        <label for="pin-input">PIN</label>
        <input id="pin-input" class="pin-input" type="password" inputmode="numeric" autocomplete="off" pattern="[0-9]{4,8}" required />
      </div>
      <div class="dialog-actions">
        <button type="button" class="btn" id="pin-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="pin-submit"></button>
      </div>
    </form>
  </dialog>
</AdminBase>

<style>
  .clock-now { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .clock-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.875rem; }
  .clock-person {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    min-height: 148px;
    padding: 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--panel);
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.12s var(--ease), border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .clock-person:hover:not(:disabled) { border-color: color-mix(in srgb, var(--ink) 30%, var(--line)); box-shadow: 0 6px 18px rgba(28, 27, 25, 0.08); }
  .clock-person:active:not(:disabled) { transform: scale(0.98); }
  .clock-person:disabled { opacity: 0.55; cursor: not-allowed; }
  .clock-person[data-action='out'] { border-color: color-mix(in srgb, var(--teal) 35%, var(--line)); }
  .clock-avatar { width: 48px; height: 48px; font-size: 1rem; }
  .clock-name { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.01em; margin-top: auto; }
  .clock-result {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--sage);
    background: var(--sage-soft);
    border-radius: var(--r-md);
    padding: 0.875rem 1rem;
    margin-bottom: 1rem;
  }
  .clock-result:empty { display: none; }
  .pin-input { font-size: 1.75rem; letter-spacing: 0.5em; text-align: center; min-height: 64px; }
</style>

<script>
  import { post } from '@/lib/time-clock/admin-client';

  const dialog = document.querySelector<HTMLDialogElement>('#pin-dialog')!;
  const form = document.querySelector<HTMLFormElement>('#pin-form')!;
  const title = document.querySelector<HTMLElement>('#pin-title')!;
  const error = document.querySelector<HTMLElement>('#pin-error')!;
  const input = document.querySelector<HTMLInputElement>('#pin-input')!;
  const submit = document.querySelector<HTMLButtonElement>('#pin-submit')!;
  const result = document.querySelector<HTMLElement>('#clock-result')!;
  const now = document.querySelector<HTMLElement>('#clock-now');
  const tick = () => {
    if (now) now.textContent = new Date().toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' });
  };
  tick();
  setInterval(tick, 15_000);

  let selected: { id: string; action: string } | null = null;

  document.querySelectorAll<HTMLButtonElement>('.clock-person').forEach((button) => {
    button.addEventListener('click', () => {
      const { id, name, action } = button.dataset;
      if (!id || !action) return;
      selected = { id, action };
      const verb = action === 'in' ? 'Clock in' : 'Clock out';
      title.textContent = `${verb}: ${name}`;
      submit.textContent = verb;
      error.textContent = '';
      input.value = '';
      dialog.showModal();
      input.focus();
    });
  });

  document.querySelector('#pin-cancel')!.addEventListener('click', () => dialog.close());

  // Clear the PIN however the dialog closes, including the Escape key.
  dialog.addEventListener('close', () => {
    input.value = '';
    selected = null;
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selected) return;
    submit.disabled = true;
    error.textContent = '';
    const { data, error: message } = await post<{ name: string; action: string; at: string }>('/api/admin/clock/', {
      staffId: selected.id,
      action: selected.action,
      pin: input.value,
    });
    submit.disabled = false;
    if (!data) {
      error.textContent = message;
      input.value = '';
      input.focus();
      return;
    }
    dialog.close();
    const at = new Date(data.at).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    result.textContent = `${data.name} clocked ${data.action} at ${at}.`;
    setTimeout(() => location.reload(), 2500);
  });
</script>

---
// Cart drawer mount point. Owns the global CSS (drawer + items + footer
// + toast) and mounts the Preact island that owns all state and logic.
// `transition:persist` keeps the island alive across view transitions
// so subscribers and open/close state don't get reset on navigation.
import CartDrawer from './cart/CartDrawer.tsx';
---

<div id="cart-system" transition:persist="cart-system">
  <CartDrawer client:load />
</div>

<style is:global>
  /* ─── Overlay ─────────────────────────── */
  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
    backdrop-filter: blur(2px);
  }
  .cart-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  /* ─── Drawer ──────────────────────────── */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    max-width: 92vw;
    background: var(--color-cream);
    z-index: 201;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.08);
  }
  .cart-drawer[aria-hidden="false"] {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .cart-drawer__header h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-drawer__count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--color-gold);
    color: var(--color-charcoal);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__close {
    padding: 0.5rem;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-stone);
    transition: color 0.2s;
  }
  .cart-drawer__close:hover { color: var(--color-charcoal); }

  /* ─── Shipping notice ─────────────────── */
  .cart-drawer__shipping {
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--color-cream-dark);
  }

  .shipping-bar__text {
    font-size: 0.78rem;
    color: var(--color-slate);
    margin-top: 0.4rem;
    text-align: center;
    max-width: none;
  }

  /* ─── Cart Items ──────────────────────── */
  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem;
  }

  .cart-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-cream-dark);
    animation: fadeInUp 0.3s ease both;
  }

  .cart-item--optimistic {
    /* Subtle hint that this line is still being confirmed */
    animation: fadeInUp 0.25s ease both;
    opacity: 0.85;
  }

  .cart-item--unavailable {
    opacity: 0.6;
  }

  .cart-item__image {
    width: 80px;
    height: 80px;
    background: var(--color-cream-dark);
    flex-shrink: 0;
    overflow: hidden;
    display: block;
    border-radius: 0;
    transition: opacity 0.2s;
  }

  .cart-item__image:hover { opacity: 0.8; }

  .cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    flex: 1;
    min-width: 0;
  }

  .cart-item__title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-charcoal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    text-decoration: none;
    transition: color 0.2s;
  }

  a.cart-item__title:hover { color: var(--color-gold); }

  .cart-item__variant {
    font-size: 0.78rem;
    color: var(--color-stone);
    margin-top: 0.15rem;
  }

  .cart-item__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
  }

  .cart-item__qty {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--color-cream-dark);
    border-radius: 0;
    overflow: hidden;
  }

  .cart-item__qty button {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    color: var(--color-slate);
    transition: background 0.2s;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .cart-item__qty button:hover:not(:disabled) { background: var(--color-cream-dark); }
  .cart-item__qty button:disabled { cursor: not-allowed; }

  .cart-item__qty span {
    width: 28px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .cart-item__qty button { width: 36px; height: 36px; font-size: 1rem; }
    .cart-item__qty span { width: 32px; font-size: 0.9rem; }
  }

  .cart-item__price {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .cart-item__remove {
    font-size: 0.72rem;
    color: var(--color-stone);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-top: 0.35rem;
    display: inline-block;
    transition: color 0.2s;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .cart-item__remove:hover { color: #c0392b; }
  .cart-item__remove:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ─── Empty state ─────────────────────── */
  .cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .cart-empty__icon {
    margin-bottom: 0.75rem;
  }

  .cart-drawer__empty p {
    color: var(--color-stone);
    font-size: 0.95rem;
  }

  /* ─── Footer ──────────────────────────── */
  .cart-drawer__footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-cream-dark);
    background: var(--color-warm-white);
  }

  .cart-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .cart-footer__row span:first-child {
    font-size: 0.9rem;
    color: var(--color-slate);
  }

  .cart-footer__total {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .cart-footer__note {
    font-size: 0.75rem;
    color: var(--color-stone);
    margin-bottom: 1rem;
  }

  .cart-footer__rewards {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: #7a5a06;
    background: color-mix(in srgb, var(--color-gold, #b8860b) 12%, transparent);
    border-radius: 0;
    letter-spacing: 0.02em;
  }
  .cart-footer__rewards svg {
    flex-shrink: 0;
    stroke: #7a5a06;
  }

  /* ─── Cart Footer Trust ─────────────── */
  .cart-footer__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-stone);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cart-footer__trust-dot { color: var(--color-cream-dark); }

  /* Cart badge bounce on add */
  @keyframes cartBadgeBounce {
    0% { transform: scale(1); }
    30% { transform: scale(1.5); }
    50% { transform: scale(0.9); }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  .nav__cart-count.bounce,
  #mobile-cart-count.bounce,
  #bottom-nav-cart-count.bounce {
    animation: cartBadgeBounce 0.5s var(--ease-out);
  }

  /* ─── Unit price ────────────────────────── */
  .cart-item__unit-price {
    font-size: 0.7rem;
    color: var(--color-stone);
    margin-top: 0.1rem;
  }

  /* ─── Checkout alert ──────────────────────── */
  .cart-footer__alert {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: #991B1B;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.6rem 0.75rem;
    border-radius: 0;
    margin-bottom: 0.75rem;
    animation: fadeInUp 0.25s ease both;
  }

  /* ─── Checkout loading state ────────────── */
  .cart-footer__checkout--loading {
    opacity: 0.6;
    pointer-events: none;
    position: relative;
  }

  /* ─── Toast notification ────────────────── */
  .cart-toast {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-charcoal);
    color: var(--color-cream);
    padding: 0.75rem 1.25rem;
    border-radius: 0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    max-width: 340px;
  }

  .cart-toast--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .cart-toast__text {
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }

  .cart-toast__title {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-toast__sub {
    display: block;
    font-size: 0.72rem;
    color: var(--color-gold);
    font-weight: 400;
  }

  .cart-toast__check {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .cart-toast {
      top: auto;
      bottom: 100px;
      right: 0.75rem;
      left: 0.75rem;
      max-width: none;
    }
  }
</style>

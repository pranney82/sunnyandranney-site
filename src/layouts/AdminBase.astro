---
import type { AdminRole } from '@/lib/admin-auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
const role: AdminRole | undefined = admin?.role;
const path = Astro.url.pathname;

// Feather-style line icons (MIT), drawn inline so the page needs no image requests.
const ICONS: Record<string, string> = {
  schedule: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  hours: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  staff: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  payroll: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  history: '<polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/>',
  gusto: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
};

interface NavLink {
  href: string;
  label: string;
  short: string;
  icon: string;
  /** False keeps a rarely used page off the phone tab bar; it's under More instead. */
  tab?: boolean;
}

const sections: Array<{ heading: string; links: NavLink[] }> =
  role === 'manager'
    ? [
        {
          heading: 'Team',
          links: [
            { href: '/admin/schedule/', label: 'Schedule', short: 'Schedule', icon: 'schedule' },
            { href: '/admin/hours/', label: 'Hours', short: 'Hours', icon: 'hours' },
            { href: '/admin/clock/', label: 'Time clock', short: 'Clock', icon: 'clock' },
            { href: '/admin/staff/', label: 'Staff', short: 'Staff', icon: 'staff' },
          ],
        },
        {
          heading: 'Pay',
          links: [
            { href: '/admin/payroll/', label: 'Payroll', short: 'Payroll', icon: 'payroll' },
            { href: '/admin/hours/history/', label: 'Gusto history', short: 'History', icon: 'history', tab: false },
          ],
        },
        ...(admin?.owner
          ? [{ heading: 'Settings', links: [{ href: '/admin/gusto/', label: 'Gusto', short: 'Gusto', icon: 'gusto', tab: false }] }]
          : []),
      ]
    : role === 'kiosk'
      ? [
          {
            heading: 'Store',
            links: [
              { href: '/admin/clock/', label: 'Time clock', short: 'Clock', icon: 'clock' },
              { href: '/admin/schedule/', label: 'Schedule', short: 'Schedule', icon: 'schedule' },
            ],
          },
        ]
      : [];

const links = sections.flatMap((section) => section.links);
const currentHref = links
  .filter((link) => path.startsWith(link.href))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
const tabLinks = links.filter((link) => link.tab !== false);
const moreLinks = links.filter((link) => link.tab === false);
const moreCurrent = moreLinks.some((link) => link.href === currentHref);
const roleLabel = admin?.owner ? 'Owner' : role === 'manager' ? 'Manager' : role === 'kiosk' ? 'Store tablet' : '';
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF7F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Sunny & Ranney Admin</title>
  </head>
  <body class:list={[{ 'has-nav': links.length > 0 }]}>
    <div class="shell">
      <aside class="sidebar" aria-label="Admin">
        <a class="brand" href="/admin/">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.25" fill="currentColor" stroke="none" />
              <path d="M12 2.5v2.25M12 19.25v2.25M2.5 12h2.25M19.25 12h2.25M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">Sunny &amp; Ranney</span>
            <span class="brand-sub">Admin</span>
          </span>
        </a>

        {
          sections.length > 0 && (
            <nav class="side-nav">
              {sections.map((section) => (
                <div class="side-section">
                  <p class="side-heading">{section.heading}</p>
                  {section.links.map((link) => (
                    <a href={link.href} class="side-link" aria-current={link.href === currentHref ? 'page' : undefined}>
                      <Fragment set:html={icon(link.icon)} />
                      <span>{link.label}</span>
                    </a>
                  ))}
                </div>
              ))}
            </nav>
          )
        }

        {
          admin && (
            <div class="who">
              <span class="who-avatar" aria-hidden="true">{admin.email.slice(0, 1).toUpperCase()}</span>
              <span class="who-text">
                <span class="who-email">{admin.email}</span>
                <span class="who-role">{roleLabel}</span>
              </span>
            </div>
          )
        }
      </aside>

      <main class="main">
        <div class="main-inner">
          <slot />
        </div>
      </main>
    </div>

    {
      links.length > 0 && (
        <nav class="tabbar" aria-label="Admin">
          {tabLinks.map((link) => (
            <a href={link.href} class="tab" aria-current={link.href === currentHref ? 'page' : undefined}>
              <Fragment set:html={icon(link.icon)} />
              <span>{link.short}</span>
            </a>
          ))}
          {moreLinks.length > 0 && (
            <details class="tab-more">
              <summary class:list={['tab', { 'tab-current': moreCurrent }]}>
                <Fragment set:html={icon('more')} />
                <span>More</span>
              </summary>
              <div class="more-sheet">
                {moreLinks.map((link) => (
                  <a href={link.href} class="more-link" aria-current={link.href === currentHref ? 'page' : undefined}>
                    <Fragment set:html={icon(link.icon)} />
                    <span>{link.label}</span>
                  </a>
                ))}
              </div>
            </details>
          )}
        </nav>
      )
    }
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'DM Sans';
    src: url('/fonts/DMSans-Variable.woff2') format('woff2');
    font-weight: 100 1000;
    font-style: normal;
    font-display: swap;
  }

  /* The register's palette (Sunny & Ranney Register, version 4), so both feel like one system. */
  :root {
    color-scheme: light;
    --font: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    --bg: #faf7f2;
    --panel: #ffffff;
    --sunk: #f5f1ea;
    --ink: #2c2c2c;
    --ink-2: #5a5a58;
    --ink-3: #6b6b68;
    --line: #e6e0d6;
    --gold: #ffd400;
    --gold-soft: #fff4b8;
    --on-gold: #2c2c2c;
    --clay: #8c4627;
    --clay-soft: #fbece2;
    --sage: #45613b;
    --sage-soft: #e7efe2;
    --teal: #1a6580;
    --teal-soft: #e2eef2;
    --red: #a12a1e;
    --red-soft: #fbe6e2;
    --scrim: rgba(28, 27, 25, 0.42);
    --shadow: 0 18px 48px rgba(28, 27, 25, 0.22);
    --shadow-sm: 0 1px 2px rgba(28, 27, 25, 0.05), 0 1px 1px rgba(28, 27, 25, 0.03);
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 16px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --sidebar: 248px;

    /* Older names the pages still use. */
    --bg-card: var(--panel);
    --text: var(--ink);
    --text-muted: var(--ink-3);
    --border: var(--line);
    --accent: var(--ink);
    --success: var(--sage);
    --warning: var(--clay);
    --danger: var(--red);
    --radius: var(--r-md);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #141412;
      --panel: #1e1d1b;
      --sunk: #191816;
      --ink: #f1eee8;
      --ink-2: #c9c4ba;
      --ink-3: #a8a296;
      --line: #34322e;
      --gold-soft: #4a3f00;
      --clay: #eba684;
      --clay-soft: #3a241a;
      --sage: #a8c79a;
      --sage-soft: #1d2a19;
      --teal: #7bbfd6;
      --teal-soft: #15313b;
      --red: #f2918a;
      --red-soft: #3b1c18;
      --scrim: rgba(0, 0, 0, 0.6);
      --shadow: 0 18px 48px rgba(0, 0, 0, 0.5);
      --shadow-sm: none;
    }
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'ss01';
  }

  a { color: var(--teal); text-underline-offset: 2px; }

  :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 4px; }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Classes like .btn set display, which would otherwise beat the hidden attribute. */
  [hidden] { display: none !important; }

  /* ── Shell ─────────────────────────────────────────────── */
  .shell { min-height: 100vh; }

  .sidebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: calc(0.75rem + env(safe-area-inset-top, 0px)) 1rem 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .brand { display: inline-flex; align-items: center; gap: 0.625rem; color: var(--ink); text-decoration: none; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--gold);
    color: var(--on-gold);
    flex: none;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-weight: 700; font-size: 0.9688rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.75rem; color: var(--ink-3); font-weight: 500; }

  .side-nav, .who { display: none; }

  .main-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  body.has-nav .main-inner { padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px)); }

  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    padding: 0.375rem 0.25rem calc(0.375rem + env(safe-area-inset-bottom, 0px));
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.375rem 0;
    min-height: 52px;
    justify-content: center;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: var(--r-sm);
  }
  .tab[aria-current='page'], .tab-current { color: var(--ink); }
  .tab[aria-current='page'] svg, .tab-current svg { color: var(--ink); stroke-width: 2.25; }

  .tab-more summary { list-style: none; cursor: pointer; }
  .tab-more summary::-webkit-details-marker { display: none; }
  .tab-more[open] summary { color: var(--ink); }
  .more-sheet {
    position: fixed;
    right: 0.5rem;
    bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    min-width: 13rem;
    padding: 0.375rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
  }
  .more-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .more-link svg { color: var(--ink-3); }
  .more-link:hover, .more-link[aria-current='page'] { background: var(--sunk); }

  @media (min-width: 1024px) {
    .shell { display: grid; grid-template-columns: var(--sidebar) 1fr; }
    .tabbar { display: none; }
    body.has-nav .main-inner { padding-bottom: 4rem; }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 1.25rem 0.875rem;
      border-bottom: 0;
      border-right: 1px solid var(--line);
      background: var(--sunk);
    }
    .brand { padding: 0.25rem 0.5rem 1.25rem; }

    .side-nav { display: flex; flex-direction: column; gap: 1.25rem; flex: 1; overflow-y: auto; }
    .side-heading {
      padding: 0 0.625rem 0.375rem;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .side-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5625rem 0.625rem;
      border-radius: 10px;
      color: var(--ink-2);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9375rem;
      transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
    }
    .side-link svg { color: var(--ink-3); flex: none; }
    .side-link:hover { background: var(--panel); color: var(--ink); }
    .side-link[aria-current='page'] { background: var(--panel); color: var(--ink); box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line); }
    .side-link[aria-current='page'] svg { color: var(--ink); }
    .side-link[aria-current='page']::after {
      content: '';
      margin-left: auto;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--gold) 30%, transparent);
    }

    .who {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.875rem 0.5rem 0;
      border-top: 1px solid var(--line);
      margin-top: 1rem;
      min-width: 0;
    }
    .who-avatar {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--panel);
      box-shadow: inset 0 0 0 1px var(--line);
      font-weight: 700;
      font-size: 0.8125rem;
      flex: none;
    }
    .who-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
    .who-email { font-size: 0.8125rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .who-role { font-size: 0.75rem; color: var(--ink-3); }

    .main-inner { padding: 2.25rem 2.5rem 4rem; }
  }

  /* ── Page header ───────────────────────────────────────── */
  .page-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .page-header h1 { font-size: 1.75rem; line-height: 1.15; font-weight: 700; letter-spacing: -0.02em; }
  .page-header .muted { margin-top: 0.25rem; }
  .page-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  .muted { color: var(--ink-3); font-size: 0.9375rem; }

  h2 { font-size: 1.0625rem; font-weight: 700; letter-spacing: -0.01em; }

  /* ── Buttons ───────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.15s var(--ease), border-color 0.15s var(--ease), transform 0.1s var(--ease);
    white-space: nowrap;
  }
  .btn:hover { border-color: color-mix(in srgb, var(--ink) 28%, var(--line)); }
  .btn:active:not(:disabled) { transform: translateY(1px); }
  .btn:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; }
  .btn-primary { background: var(--gold); border-color: var(--gold); color: var(--on-gold); }
  .btn-primary:hover { background: color-mix(in srgb, var(--gold) 88%, #000); border-color: color-mix(in srgb, var(--gold) 88%, #000); color: var(--on-gold); }
  .btn-dark { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .btn-dark:hover { background: color-mix(in srgb, var(--ink) 85%, var(--bg)); color: var(--bg); }
  .btn-danger { color: var(--red); }
  .btn-danger:hover { background: var(--red-soft); border-color: color-mix(in srgb, var(--red) 40%, var(--line)); color: var(--red); }
  .btn-ghost { background: transparent; border-color: transparent; box-shadow: none; }
  .btn-ghost:hover { background: var(--sunk); border-color: transparent; }
  .btn-icon { width: 44px; padding: 0; }
  .btn-small { min-height: 36px; padding: 0.375rem 0.75rem; font-size: 0.875rem; }
  .btn svg { flex: none; }

  .btn-group { display: inline-flex; align-items: stretch; border-radius: 10px; box-shadow: var(--shadow-sm); }
  .btn-group .btn { box-shadow: none; border-radius: 0; }
  .btn-group .btn:first-child { border-radius: 10px 0 0 10px; }
  .btn-group .btn:last-child { border-radius: 0 10px 10px 0; }
  .btn-group .btn + .btn { margin-left: -1px; }
  .btn-group .btn-label { cursor: default; font-weight: 600; min-width: 7.5rem; }
  .btn-group .btn-label:hover { border-color: var(--line); }

  /* ── Surfaces ──────────────────────────────────────────── */
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1.25rem;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem; }
  .stat {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 1rem 1.125rem;
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }
  .stat-label { font-size: 0.8125rem; font-weight: 600; color: var(--ink-3); }
  .stat-value { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-top: 0.25rem; font-variant-numeric: tabular-nums; }
  .stat-value small { font-size: 0.875rem; font-weight: 600; color: var(--ink-3); letter-spacing: 0; margin-left: 0.25rem; }
  .stat-note { font-size: 0.8125rem; color: var(--ink-3); margin-top: 0.125rem; }
  .stat-accent { background: var(--gold-soft); border-color: color-mix(in srgb, var(--gold) 45%, var(--line)); }
  .stat-accent .stat-label { color: var(--ink-2); }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex: none;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: var(--sunk);
    color: var(--ink-2);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .avatar[data-tone='0'] { background: var(--gold-soft); color: var(--ink); }
  .avatar[data-tone='1'] { background: var(--sage-soft); color: var(--sage); }
  .avatar[data-tone='2'] { background: var(--teal-soft); color: var(--teal); }
  .avatar[data-tone='3'] { background: var(--clay-soft); color: var(--clay); }
  .person { display: inline-flex; align-items: center; gap: 0.75rem; min-width: 0; font-weight: 600; }

  /* ── Badges ────────────────────────────────────────────── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;

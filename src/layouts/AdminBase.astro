---
import type { AdminRole } from '@/lib/admin-auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
const role: AdminRole | undefined = admin?.role;
const path = Astro.url.pathname;

// Feather-style line icons (MIT), drawn inline so the page needs no image requests.
const ICONS: Record<string, string> = {
  giving: '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>',
  schedule: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  hours: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  staff: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  payroll: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  history: '<polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/>',
  gusto: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  tax: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  buying: '<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  receive: '<line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  vendors: '<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  more: '<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>',
  today: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
};

interface NavLink {
  href: string;
  label: string;
  short: string;
  icon: string;
  /** False keeps a rarely used page off the phone tab bar; it's under More instead. */
  tab?: boolean;
}

const sections: Array<{ heading: string; links: NavLink[] }> =
  role === 'manager'
    ? [
        {
          heading: 'Team',
          links: [
            { href: '/admin/', label: 'Today', short: 'Today', icon: 'today' },
            { href: '/admin/schedule/', label: 'Schedule', short: 'Schedule', icon: 'schedule' },
            { href: '/admin/hours/', label: 'Hours', short: 'Hours', icon: 'hours' },
            { href: '/admin/clock/', label: 'Time clock', short: 'Clock', icon: 'clock', tab: false },
            { href: '/admin/staff/', label: 'Staff', short: 'Staff', icon: 'staff' },
          ],
        },
        {
          heading: 'Stock',
          links: [
            { href: '/admin/buying/', label: 'Purchase orders', short: 'Buying', icon: 'buying', tab: false },
            { href: '/admin/receiving/', label: 'Receiving', short: 'Receive', icon: 'receive', tab: false },
            { href: '/admin/buying/costs/', label: 'Costs to match', short: 'Costs', icon: 'buying', tab: false },
            { href: '/admin/vendors/', label: 'Vendors', short: 'Vendors', icon: 'vendors', tab: false },
          ],
        },
        {
          heading: 'Pay',
          links: [
            { href: '/admin/payroll/', label: 'Payroll', short: 'Payroll', icon: 'payroll' },
            { href: '/admin/hours/history/', label: 'Gusto history', short: 'History', icon: 'history', tab: false },
            { href: '/admin/sales-tax/', label: 'Sales tax', short: 'Tax', icon: 'tax', tab: false },
            { href: '/admin/donations/', label: 'Donations', short: 'Giving', icon: 'giving', tab: false },
          ],
        },
        ...(admin?.owner
          ? [{ heading: 'Settings', links: [{ href: '/admin/gusto/', label: 'Gusto', short: 'Gusto', icon: 'gusto', tab: false }] }]
          : []),
      ]
    : role === 'kiosk'
      ? [
          {
            heading: 'Store',
            links: [
              { href: '/admin/clock/', label: 'Time clock', short: 'Clock', icon: 'clock' },
              { href: '/admin/schedule/', label: 'Schedule', short: 'Schedule', icon: 'schedule' },
            ],
          },
        ]
      : [];

const links = sections.flatMap((section) => section.links);
// Today is /admin/ itself; every other link also matches the pages under it.
const currentHref = links
  .filter((link) => (link.href === '/admin/' ? path === '/admin/' || path === '/admin' : path.startsWith(link.href)))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
const tabLinks = links.filter((link) => link.tab !== false);
const moreLinks = links.filter((link) => link.tab === false);
const moreCurrent = moreLinks.some((link) => link.href === currentHref);
const roleLabel = admin?.owner ? 'Owner' : role === 'manager' ? 'Manager' : role === 'kiosk' ? 'Store tablet' : '';
// The store's logo, from its Cloudflare Images account (allowed by the admin's CSP).
const LOGO = 'https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ';
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" />
    <title>{title} | Sunny & Ranney Admin</title>
  </head>
  <body class:list={[{ 'has-nav': links.length > 0 }]}>
    <div class="shell">
      <aside class="sidebar" aria-label="Admin">
        <a class="brand" href="/admin/" aria-label="Sunny & Ranney Admin, home">
          <picture>
            <img
              class="brand-logo"
              src={`${LOGO}/logo-tagline-light-bg/w=132,h=52,fit=scale-down,format=auto`}
              srcset={`${LOGO}/logo-tagline-light-bg/w=132,h=52,fit=scale-down,format=auto 1x, ${LOGO}/logo-tagline-light-bg/w=264,h=104,fit=scale-down,format=auto 2x`}
              alt="Sunny & Ranney"
              width="132"
              height="52"
              decoding="async"
            />
          </picture>
          <span class="brand-sub">Admin</span>
        </a>

        {
          role === 'manager' && (
            <button type="button" class="search-button" data-open-palette aria-keyshortcuts="Meta+K Control+K">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
              <span>Search</span>
              <kbd class="search-kbd">⌘K</kbd>
            </button>
          )
        }

        {
          sections.length > 0 && (
            <nav class="side-nav">
              {sections.map((section) => (
                <div class="side-section">
                  <p class="side-heading">{section.heading}</p>
                  {section.links.map((link) => (
                    <a href={link.href} class="side-link" aria-current={link.href === currentHref ? 'page' : undefined}>
                      <Fragment set:html={icon(link.icon)} />
                      <span>{link.label}</span>
                    </a>
                  ))}
                </div>
              ))}
            </nav>
          )
        }

        {
          admin && (
            <div class="who">
              <span class="who-avatar" aria-hidden="true">{admin.email.slice(0, 1).toUpperCase()}</span>
              <span class="who-text">
                <span class="who-email">{admin.email}</span>
                <span class="who-role">{roleLabel}</span>
              </span>
            </div>
          )
        }
      </aside>

      <main class="main">
        <div class="main-inner">
          <slot />
        </div>
      </main>
    </div>

    {
      links.length > 0 && (
        <nav class="tabbar" aria-label="Admin">
          {tabLinks.map((link) => (
            <a href={link.href} class="tab" aria-current={link.href === currentHref ? 'page' : undefined}>
              <Fragment set:html={icon(link.icon)} />
              <span>{link.short}</span>
            </a>
          ))}
          {moreLinks.length > 0 && (
            <details class="tab-more">
              <summary class:list={['tab', { 'tab-current': moreCurrent }]}>
                <Fragment set:html={icon('more')} />
                <span>More</span>
              </summary>
              <div class="more-sheet">
                {moreLinks.map((link) => (
                  <a href={link.href} class="more-link" aria-current={link.href === currentHref ? 'page' : undefined}>
                    <Fragment set:html={icon(link.icon)} />
                    <span>{link.label}</span>
                  </a>
                ))}
              </div>
            </details>
          )}
        </nav>
      )
    }
  </body>
</html>

<script>
  import '@/lib/admin/shell';
</script>

<style is:global>
  @font-face {
    font-family: 'DM Sans';
    src: url('/fonts/DMSans-Variable.woff2') format('woff2');
    font-weight: 100 1000;
    font-style: normal;
    font-display: swap;
  }

  /* The register's palette (Sunny & Ranney Register, version 4), so both feel like one system. */
  :root {
    color-scheme: light;
    --font: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    --bg: #faf7f2;
    --panel: #ffffff;
    --sunk: #f5f1ea;
    --ink: #2c2c2c;
    --ink-2: #5a5a58;
    --ink-3: #6b6b68;
    --line: #e6e0d6;
    --gold: #ffd400;
    --gold-soft: #fff4b8;
    --on-gold: #2c2c2c;
    --clay: #8c4627;
    --clay-soft: #fbece2;
    --sage: #45613b;
    --sage-soft: #e7efe2;
    --teal: #1a6580;
    --teal-soft: #e2eef2;
    --red: #a12a1e;
    --red-soft: #fbe6e2;
    --scrim: rgba(28, 27, 25, 0.42);
    --shadow: 0 18px 48px rgba(28, 27, 25, 0.22);
    --shadow-sm: 0 1px 2px rgba(28, 27, 25, 0.05), 0 1px 1px rgba(28, 27, 25, 0.03);
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 16px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --sidebar: 248px;

    /* Older names the pages still use. */
    --bg-card: var(--panel);
    --text: var(--ink);
    --text-muted: var(--ink-3);
    --border: var(--line);
    --accent: var(--ink);
    --success: var(--sage);
    --warning: var(--clay);
    --danger: var(--red);
    --radius: var(--r-md);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'ss01';
  }

  a { color: var(--teal); text-underline-offset: 2px; }

  :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; border-radius: 4px; }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Classes like .btn set display, which would otherwise beat the hidden attribute. */
  [hidden] { display: none !important; }

  /* ── Shell ─────────────────────────────────────────────── */
  .shell { min-height: 100vh; }

  .sidebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: calc(0.75rem + env(safe-area-inset-top, 0px)) 1rem 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--ink); text-decoration: none; }
  .brand picture { display: block; line-height: 0; }
  .brand-logo { display: block; width: auto; height: 38px; }
  .brand-sub {
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .side-nav, .who, .search-button { display: none; }

  /* ── Search, toasts, shortcuts (lib/admin/shell.ts) ───── */
  .search-button {
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.25rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    color: var(--ink-3);
    font: inherit;
    font-size: 0.9063rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }
  .search-button span { flex: 1; }
  .search-button:hover { color: var(--ink); border-color: color-mix(in srgb, var(--ink) 25%, var(--line)); }
  kbd, .search-kbd {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--sunk);
    color: var(--ink-2);
    font: 600 0.75rem/1.4 var(--font);
    text-align: center;
  }

  .toasts {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 60;
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    width: max-content;
    max-width: calc(100vw - 2rem);
    pointer-events: none;
  }
  body.has-nav .toasts { bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 1024px) { body.has-nav .toasts { bottom: 1.5rem; left: calc(50% + var(--sidebar) / 2); } }
  .toast {
    padding: 0.75rem 1.125rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: var(--shadow);
    animation: toast-in 0.3s var(--ease) both;
  }
  .toast-error { background: var(--red); color: #fff; }
  .toast-out { opacity: 0; transform: translateY(6px); transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); }
  @keyframes toast-in { from { opacity: 0; transform: translateY(8px) scale(0.98); } }

  dialog.palette, dialog.shortcuts {
    margin: 12vh auto auto;
    width: min(560px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--panel);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  dialog.palette::backdrop, dialog.shortcuts::backdrop { background: var(--scrim); }
  dialog.palette[open], dialog.shortcuts[open] { animation: pop 0.2s var(--ease) both; }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px) scale(0.985); } }
  .palette input {
    width: 100%;
    padding: 1rem 1.125rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    outline: none;
  }
  .palette ul { list-style: none; max-height: 50vh; overflow-y: auto; padding: 0.375rem; }
  .palette li[role='option'] {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
  }
  .palette li[aria-selected='true'] { background: var(--teal-soft); color: var(--ink); }
  .palette-hint { color: var(--ink-3); font-weight: 500; font-size: 0.8125rem; }
  .palette-empty { padding: 0.75rem; color: var(--ink-3); }
  .palette-foot { display: flex; gap: 0.25rem; align-items: center; padding: 0.625rem 1rem; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 0.8125rem; }
  .shortcuts { padding: 1.25rem 1.5rem !important; }
  .shortcuts h2 { margin-bottom: 0.75rem; }
  .shortcuts dl { display: grid; grid-template-columns: auto 1fr; gap: 0.625rem 1.25rem; align-items: center; margin-bottom: 1rem; }
  .shortcuts dt { display: flex; gap: 0.25rem; }
  @media (prefers-reduced-motion: reduce) {
    .toast, dialog.palette[open], dialog.shortcuts[open] { animation: none; }
  }

  /* Streamed pages: a skeleton holds the place of the part that waits on Gusto,
     and disappears as soon as that part arrives after it. No script needed. */
  .stream > .skeleton:not(:last-child) { display: none; }
  .skeleton { display: grid; gap: 0.75rem; }
  .sk { display: block; height: 0.875rem; border-radius: 6px; background: linear-gradient(90deg, var(--sunk) 0%, var(--line) 50%, var(--sunk) 100%) 0 0 / 200% 100%; animation: shimmer 1.2s linear infinite; }
  .sk-title { width: 40%; height: 1.125rem; }
  .sk-line { width: 65%; }
  .sk-row { height: 2.25rem; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .sk { animation: none; } }

  .main-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  body.has-nav .main-inner { padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px)); }

  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    padding: 0.375rem 0.25rem calc(0.375rem + env(safe-area-inset-bottom, 0px));
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.375rem 0;
    min-height: 52px;
    justify-content: center;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: var(--r-sm);
  }
  .tab[aria-current='page'], .tab-current { color: var(--teal); }
  .tab[aria-current='page'] svg, .tab-current svg { color: var(--teal); stroke-width: 2.25; }

  .tab-more summary { list-style: none; cursor: pointer; }
  .tab-more summary::-webkit-details-marker { display: none; }
  .tab-more[open] summary { color: var(--ink); }
  .more-sheet {
    position: fixed;
    right: 0.5rem;
    bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    min-width: 13rem;
    padding: 0.375rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
  }
  .more-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0.875rem;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .more-link svg { color: var(--ink-3); }
  .more-link:hover, .more-link[aria-current='page'] { background: var(--sunk); }

  @media (min-width: 1024px) {
    .shell { display: grid; grid-template-columns: var(--sidebar) 1fr; }
    .tabbar { display: none; }
    body.has-nav .main-inner { padding-bottom: 4rem; }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 1.25rem 0.875rem;
      border-bottom: 0;
      border-right: 1px solid var(--line);
      background: var(--sunk);
    }
    .brand { padding: 0.25rem 0.5rem 1.25rem; }
    .search-button { display: flex; }

    .side-nav { display: flex; flex-direction: column; gap: 1.25rem; flex: 1; overflow-y: auto; }
    .side-heading {
      padding: 0 0.625rem 0.375rem;
      font-size: 0.6875rem;
      font-weight: 700;

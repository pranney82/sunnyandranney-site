---
import type { AdminRole } from '@/lib/admin-auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const role: AdminRole | undefined = Astro.locals.admin?.role;
const path = Astro.url.pathname;

const links =
  role === 'manager'
    ? [
        { href: '/admin/hours/', label: 'Hours' },
        { href: '/admin/hours/history/', label: 'Gusto history' },
        { href: '/admin/payroll/', label: 'Payroll' },
        { href: '/admin/staff/', label: 'Staff' },
        { href: '/admin/clock/', label: 'Time clock' },
        ...(Astro.locals.admin?.owner ? [{ href: '/admin/gusto/', label: 'Gusto' }] : []),
      ]
    : [];

const currentHref = links
  .filter((link) => path.startsWith(link.href))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Sunny & Ranney Admin</title>
  </head>
  <body>
    <header class="admin-header">
      <div class="admin-header-inner">
        <a class="admin-logo" href="/admin/">Sunny &amp; Ranney <span>Admin</span></a>
        {
          links.length > 0 && (
            <nav class="admin-nav" aria-label="Admin">
              {links.map((link) => (
                <a href={link.href} aria-current={link.href === currentHref ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </header>
    <main class="admin-container">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #faf7f2;
    --bg-card: #fff;
    --text: #2d2926;
    --text-muted: #6b6560;
    --border: #e5e0db;
    --accent: #7a5f3c;
    --accent-hover: #63492a;
    --success: #1f6e3c;
    --warning: #8f5e0e;
    --danger: #b03024;
    --radius: 8px;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    min-height: 100vh;
  }

  a { color: var(--accent); }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .admin-header { background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 0.875rem 0; }

  .admin-header-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .admin-logo { font-size: 1.0625rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .admin-logo span { color: var(--text-muted); font-weight: 400; }

  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  .admin-nav a { color: var(--text-muted); text-decoration: none; font-size: 0.9375rem; font-weight: 500; padding: 0.25rem 0; }
  .admin-nav a:hover, .admin-nav a[aria-current='page'] { color: var(--accent); }

  .admin-container { max-width: 1000px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }

  .page-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 1.25rem; }
  .page-header h1 { font-size: 1.5rem; font-weight: 700; }
  .page-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .muted { color: var(--text-muted); font-size: 0.9375rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
  }
  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }
  .btn-danger { color: var(--danger); border-color: var(--danger); }
  .btn-danger:hover { background: var(--danger); border-color: var(--danger); color: #fff; }

  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem; }

  .badge { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; background: #f0ebe6; color: var(--text-muted); white-space: nowrap; }
  .badge-pending { background: #fdf0d0; color: var(--warning); }
  .badge-approved { background: #dcf0e2; color: var(--success); }
  .badge-rejected { background: #f8dfdc; color: var(--danger); text-decoration: line-through; }
  .badge-open { background: #dbe9f7; color: #154a7a; }
  .badge-sent { background: #dbe9f7; color: #154a7a; }

  label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.25rem; }

  input, select, textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: inherit;
    color: var(--text);
    background: var(--bg-card);
  }

  input[type='checkbox'] { width: 1.25rem; min-height: 1.25rem; height: 1.25rem; accent-color: var(--accent); }
  .check { display: flex; align-items: center; gap: 0.5rem; font-weight: 500; color: var(--text); margin: 0; }

  .field { margin-bottom: 0.875rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }

  dialog { width: min(440px, calc(100vw - 2rem)); margin: auto; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); color: var(--text); }
  dialog::backdrop { background: rgba(45, 41, 38, 0.5); }
  dialog h2 { font-size: 1.125rem; margin-bottom: 0.875rem; }

  .dialog-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; }

  .form-error { color: var(--danger); font-size: 0.9375rem; font-weight: 500; margin-bottom: 0.75rem; }
  .form-error:empty { display: none; }

  .notice { padding: 0.75rem 1rem; border-radius: var(--radius); background: #fdf0d0; color: #5e3e09; margin-bottom: 1rem; font-size: 0.9375rem; }
  .empty { text-align: center; padding: 2.5rem 1rem; color: var(--text-muted); }

  .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.75rem; }
  .filters .field { flex: 1 1 150px; margin: 0; }

  table { width: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  th { text-align: left; font-size: 0.8125rem; color: var(--text-muted); font-weight: 600; padding: 0.375rem 0.5rem; border-bottom: 1px solid var(--border); }
  td { padding: 0.5rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
  tr:last-child td { border-bottom: 0; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .table-scroll { overflow-x: auto; position: relative; }
</style>

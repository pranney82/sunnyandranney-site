---
import type { AdminRole } from '@/lib/admin-auth';
import { ICONS, SIDEBAR, allLinks, currentHref as findCurrentHref, navFor, phoneNav } from '@/lib/admin/nav.mjs';

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin;
const role: AdminRole | undefined = admin?.role;
const path = Astro.url.pathname;

const nav = navFor({ role, owner: admin?.owner });
const { sections, settings: settingsLink } = nav;
const links = allLinks(nav);
const currentHref = findCurrentHref(path, links);
const phone = phoneNav(nav, currentHref);
// The sidebar's sizes come from the nav module, whose test holds the sidebar to one screen.
const sidebarSizes = `--row:${SIDEBAR.row}px;--touch-row:${SIDEBAR.touchRow}px;--heading:${SIDEBAR.heading}px;--section-gap:${SIDEBAR.gap}px`;
const roleLabel = admin?.owner ? 'Owner' : role === 'manager' ? 'Manager' : role === 'kiosk' ? 'Store tablet' : '';
// Ends the Cloudflare Access session, so a shared computer doesn't stay signed in. Not for the store tablet.
const SIGN_OUT = '/cdn-cgi/access/logout';
// The store's logo, from its Cloudflare Images account (allowed by the admin's CSP).
const LOGO = 'https://imagedelivery.net/ROYFuPmfN2vPS6mt5sCkZQ';
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" />
    <title>{title} | Sunny & Ranney Admin</title>
  </head>
  <body class:list={[{ 'has-nav': links.length > 0 }]}>
    {links.length > 0 && <a class="skip-link" href="#main">Skip to content</a>}
    <div class="shell">
      <header class="sidebar" style={sidebarSizes}>
        <a class="brand" href="/admin/" aria-label="Sunny & Ranney Admin, home">
          <picture>
            <img
              class="brand-logo"
              src={`${LOGO}/logo-tagline-light-bg/w=132,h=52,fit=scale-down,format=auto`}
              srcset={`${LOGO}/logo-tagline-light-bg/w=132,h=52,fit=scale-down,format=auto 1x, ${LOGO}/logo-tagline-light-bg/w=264,h=104,fit=scale-down,format=auto 2x`}
              alt="Sunny & Ranney"
              width="132"
              height="52"
              decoding="async"
            />
          </picture>
          <span class="brand-sub">Admin</span>
        </a>

        {
          role === 'manager' && (
            <button type="button" class="search-button" data-open-palette aria-label="Search" aria-keyshortcuts="Meta+K Control+K">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
              <span>Search</span>
              <kbd class="search-kbd">⌘K</kbd>
            </button>
          )
        }

        {
          sections.length > 0 && (
            <nav class="side-nav" aria-label="Admin">
              {sections.map((section) => (
                <div class="side-section" role="group" aria-labelledby={`side-${section.heading.toLowerCase()}`}>
                  <p class="side-heading" id={`side-${section.heading.toLowerCase()}`}>{section.heading}</p>
                  {section.links.map((link) => {
                    // Sub-pages show under their page while you're anywhere in it, as in Shopify's admin.
                    const inChild = link.children?.some((child) => child.href === currentHref) ?? false;
                    return (
                      <Fragment>
                        <a
                          href={link.href}
                          class:list={['side-link', { 'side-parent-current': inChild }]}
                          aria-current={link.href === currentHref ? 'page' : undefined}
                        >
                          <Fragment set:html={icon(link.icon)} />
                          <span>{link.label}</span>
                        </a>
                        {link.children && (
                          <div class:list={['side-children', { 'side-children-open': inChild || link.href === currentHref }]}>
                            {link.children.map((child) => (
                              <a href={child.href} class="side-link side-child" aria-current={child.href === currentHref ? 'page' : undefined}>
                                <span>{child.label}</span>
                              </a>
                            ))}
                          </div>
                        )}
                      </Fragment>
                    );
                  })}
                </div>
              ))}
            </nav>
          )
        }

        {
          admin && (
            <div class="side-foot">
              {settingsLink && (
                <a href={settingsLink.href} class="side-link" aria-current={settingsLink.href === currentHref ? 'page' : undefined}>
                  <Fragment set:html={icon(settingsLink.icon)} />
                  <span>{settingsLink.label}</span>
                </a>
              )}
              <div class="who">
                <span class="who-avatar" aria-hidden="true">{admin.email.slice(0, 1).toUpperCase()}</span>
                <span class="who-text">
                  <span class="who-email">{admin.email}</span>
                  <span class="who-role">{roleLabel}</span>
                </span>
                {role === 'manager' && (
                  <a class="who-out" href={SIGN_OUT} aria-label="Sign out" title="Sign out">
                    <Fragment set:html={icon('signout')} />
                  </a>
                )}
              </div>
            </div>
          )
        }
      </header>

      <main class="main" id="main" tabindex="-1">
        <div class="main-inner">
          <slot />
        </div>
      </main>
    </div>

    {
      links.length > 0 && (
        <nav class="tabbar" aria-label="Admin">
          {phone.tabs.map((link) => (
            <a
              href={link.href}
              class="tab"
              aria-current={link.href === currentHref ? 'page' : link.href === phone.activeTab ? 'true' : undefined}
            >
              <Fragment set:html={icon(link.icon)} />
              <span>{link.short}</span>
            </a>
          ))}
          {(phone.groups.length > 0 || role === 'manager') && (
            <details class="tab-more">
              <summary class:list={['tab', { 'tab-current': phone.moreActive }]}>
                <Fragment set:html={icon('more')} />
                <span>More</span>
              </summary>
              <div class="more-sheet">
                {[...phone.groups, ...(role === 'manager' && !settingsLink ? [[]] : [])].map((group, index, all) => (
                  <div class="more-group">
                    {group.map((link) => (
                      <a href={link.href} class="more-link" aria-current={link.href === currentHref ? 'page' : undefined}>
                        <Fragment set:html={icon(link.icon)} />
                        <span>{link.label}</span>
                      </a>
                    ))}
                    {/* Sign out ends the sheet, with Gusto settings when there is one. */}
                    {role === 'manager' && index === all.length - 1 && (
                      <a href={SIGN_OUT} class="more-link">
                        <Fragment set:html={icon('signout')} />
                        <span>Sign out</span>
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </details>
          )}
        </nav>
      )
    }
  </body>
</html>

<script>
  import '@/lib/admin/shell';
</script>

<style is:global>
  @font-face {
    font-family: 'DM Sans';
    src: url('/fonts/DMSans-Variable.woff2') format('woff2');
    font-weight: 100 1000;
    font-style: normal;
    font-display: swap;
  }

  /* The register's palette (Sunny & Ranney Register, version 4), so both feel like one system. */
  :root {
    color-scheme: light;
    --font: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
    --bg: #faf7f2;
    --panel: #ffffff;
    --sunk: #f5f1ea;
    --ink: #2c2c2c;
    --ink-2: #5a5a58;
    --ink-3: #6b6b68;
    --line: #e6e0d6;
    --gold: #ffd400;
    --gold-soft: #fff4b8;
    --on-gold: #2c2c2c;
    --clay: #8c4627;
    --clay-soft: #fbece2;
    --sage: #45613b;
    --sage-soft: #e7efe2;
    --teal: #1a6580;
    --teal-soft: #e2eef2;
    --red: #a12a1e;
    --red-soft: #fbe6e2;
    --scrim: rgba(28, 27, 25, 0.42);
    --shadow: 0 18px 48px rgba(28, 27, 25, 0.22);
    --shadow-sm: 0 1px 2px rgba(28, 27, 25, 0.05), 0 1px 1px rgba(28, 27, 25, 0.03);
    --r-sm: 8px;
    --r-md: 12px;
    --r-lg: 16px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --sidebar: 248px;

    /* Older names the pages still use. */
    --bg-card: var(--panel);
    --text: var(--ink);
    --text-muted: var(--ink-3);
    --border: var(--line);
    --accent: var(--ink);
    --success: var(--sage);
    --warning: var(--clay);
    --danger: var(--red);
    --radius: var(--r-md);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.5;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: 'ss01';
  }

  a { color: var(--teal); text-underline-offset: 2px; }

  :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; border-radius: 4px; }

  /* The first Tab on every page jumps past the navigation. */
  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 70;
    padding: 0.625rem 1rem;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  .main:focus { outline: none; }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Classes like .btn set display, which would otherwise beat the hidden attribute. */
  [hidden] { display: none !important; }

  /* ── Shell ─────────────────────────────────────────────── */
  .shell { min-height: 100vh; }

  .sidebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: calc(0.75rem + env(safe-area-inset-top, 0px)) 1rem 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .brand { display: inline-flex; align-items: center; gap: 0.75rem; color: var(--ink); text-decoration: none; }
  .brand picture { display: block; line-height: 0; }
  .brand-logo { display: block; width: auto; height: 38px; }
  .brand-sub {
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .side-nav, .side-foot { display: none; }

  /* ── Search, toasts, shortcuts (lib/admin/shell.ts) ───── */
  /* On a phone or an upright iPad, search is an icon in the top bar, as in Shopify's app. */
  .search-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    color: var(--ink-3);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }
  .search-button span, .search-button .search-kbd { display: none; }
  .search-button:hover { color: var(--ink); border-color: color-mix(in srgb, var(--ink) 25%, var(--line)); }
  kbd, .search-kbd {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--sunk);
    color: var(--ink-2);
    font: 600 0.75rem/1.4 var(--font);
    text-align: center;
  }

  .toasts {
    position: fixed;
    left: 50%;
    bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 60;
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    width: max-content;
    max-width: calc(100vw - 2rem);
    pointer-events: none;
  }
  body.has-nav .toasts { bottom: calc(5.25rem + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 1024px) { body.has-nav .toasts { bottom: 1.5rem; left: calc(50% + var(--sidebar) / 2); } }
  .toast {
    padding: 0.75rem 1.125rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: var(--shadow);
    animation: toast-in 0.3s var(--ease) both;
  }
  .toast-error { background: var(--red); color: #fff; }
  .toast-out { opacity: 0; transform: translateY(6px); transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); }
  @keyframes toast-in { from { opacity: 0; transform: translateY(8px) scale(0.98); } }

  dialog.palette, dialog.shortcuts {
    margin: 12vh auto auto;
    width: min(560px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--panel);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  dialog.palette::backdrop, dialog.shortcuts::backdrop { background: var(--scrim); }
  dialog.palette[open], dialog.shortcuts[open] { animation: pop 0.2s var(--ease) both; }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px) scale(0.985); } }
  .palette input {
    width: 100%;
    padding: 1rem 1.125rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    outline: none;
  }
  .palette ul { list-style: none; max-height: 50vh; overflow-y: auto; padding: 0.375rem; }
  .palette li[role='option'] {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
  }
  .palette li[aria-selected='true'] { background: var(--teal-soft); color: var(--ink); }
  .palette-hint { color: var(--ink-3); font-weight: 500; font-size: 0.8125rem; }
  .palette-empty { padding: 0.75rem; color: var(--ink-3); }
  .palette-foot { display: flex; gap: 0.25rem; align-items: center; padding: 0.625rem 1rem; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 0.8125rem; }
  .shortcuts { padding: 1.25rem 1.5rem !important; }
  .shortcuts h2 { margin-bottom: 0.75rem; }
  .shortcuts dl { display: grid; grid-template-columns: auto 1fr; gap: 0.625rem 1.25rem; align-items: center; margin-bottom: 1rem; }
  .shortcuts dt { display: flex; gap: 0.25rem; }
  @media (prefers-reduced-motion: reduce) {
    .toast, dialog.palette[open], dialog.shortcuts[open] { animation: none; }
  }

  /* Streamed pages: a skeleton holds the place of the part that waits on Gusto,
     and disappears as soon as that part arrives after it. No script needed. */
  .stream > .skeleton:not(:last-child) { display: none; }
  .skeleton { display: grid; gap: 0.75rem; }
  .sk { display: block; height: 0.875rem; border-radius: 6px; background: linear-gradient(90deg, var(--sunk) 0%, var(--line) 50%, var(--sunk) 100%) 0 0 / 200% 100%; animation: shimmer 1.2s linear infinite; }
  .sk-title { width: 40%; height: 1.125rem; }
  .sk-line { width: 65%; }
  .sk-row { height: 2.25rem; }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .sk { animation: none; } }

  .main-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  body.has-nav .main-inner { padding-bottom: calc(6rem + env(safe-area-inset-bottom, 0px)); }

  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    padding: 0.375rem 0.25rem calc(0.375rem + env(safe-area-inset-bottom, 0px));
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.375rem 0;
    min-height: 52px;
    justify-content: center;
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: var(--r-sm);
  }
  .tab[aria-current], .tab-current { color: var(--teal); }
  .tab[aria-current] svg, .tab-current svg { color: var(--teal); stroke-width: 2.25; }

  .tab-more summary { list-style: none; cursor: pointer; }
  .tab-more summary::-webkit-details-marker { display: none; }
  .tab-more[open] summary { color: var(--ink); }
  .more-sheet {
    position: fixed;
    right: 0.5rem;
    bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    min-width: 13rem;
    max-height: calc(100vh - 5.5rem - env(safe-area-inset-bottom, 0px) - env(safe-area-inset-top, 0px));
    max-height: calc(100dvh - 5.5rem - env(safe-area-inset-bottom, 0px) - env(safe-area-inset-top, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.375rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow);
  }
  .more-group + .more-group { margin-top: 0.1875rem; padding-top: 0.1875rem; border-top: 1px solid var(--line); }
  .more-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  .more-link svg { color: var(--ink-3); }
  .more-link:hover, .more-link[aria-current='page'] { background: var(--sunk); }

  @media (min-width: 1024px) {
    .shell { display: grid; grid-template-columns: var(--sidebar) 1fr; }
    .tabbar { display: none; }
    body.has-nav .main-inner { padding-bottom: 4rem; }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 0.625rem 0.75rem;
      border-bottom: 0;
      border-right: 1px solid var(--line);
      background: var(--sunk);
    }
    .brand { padding: 0.125rem 0.5rem 0.625rem; }
    .brand-logo { height: 32px; }
    .search-button { width: auto; height: auto; justify-content: flex-start; margin-bottom: 0.625rem; padding: 0.3125rem 0.625rem; font-size: 0.875rem; }
    .search-button span { display: block; flex: 1; }
    .search-button .search-kbd { display: inline-block; }

    /* Sized to Shopify's admin, measured 2026-11-12: 30px rows, 13px type, 16px icons, every item
       on screen with no scrollbar. DM Sans runs small, so 14px here. Windows too short for the
       list get a thin scrollbar rather than the system's 15px one. */
    .side-nav {
      display: flex;
      flex-direction: column;
      gap: var(--section-gap);
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
    .side-section { display: flex; flex-direction: column; }
    .side-heading {
      padding: 0 0.625rem 2px;
      font-size: 0.6875rem;
      line-height: calc(var(--heading) - 2px);
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--ink-3);
    }
    .side-link {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      min-height: var(--row);
      padding: 0 0.625rem;
      border-radius: var(--r-sm);
      color: var(--ink-2);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.875rem;
      line-height: 1.25rem;
      transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
    }
    .side-link svg { color: var(--ink-3); flex: none; width: 16px; height: 16px; }
    .side-link:hover { background: var(--panel); color: var(--ink); }
    /* Inside the scrolling list an outside ring would be clipped, so it sits inside the row. */
    .side-link:focus-visible { outline-offset: -2px; }

    /* When the list scrolls (an iPad, a short window), fade the edge that has more, since Safari hides scrollbars. */
    .side-nav.more-below { -webkit-mask-image: linear-gradient(#000 calc(100% - 2.5rem), transparent); mask-image: linear-gradient(#000 calc(100% - 2.5rem), transparent); }
    .side-nav.more-above { -webkit-mask-image: linear-gradient(transparent, #000 2.5rem); mask-image: linear-gradient(transparent, #000 2.5rem); }
    .side-nav.more-above.more-below {
      -webkit-mask-image: linear-gradient(transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    }
    .side-link[aria-current='page'], .side-parent-current { background: var(--panel); color: var(--ink); font-weight: 600; box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line); }
    .side-link[aria-current='page'] svg, .side-parent-current svg { color: var(--teal); }

    /* Sub-pages: no icon, lined up with their page's label, lighter until chosen. */
    .side-children { display: none; flex-direction: column; }
    .side-children-open { display: flex; }
    .side-child { padding-left: calc(0.625rem + 16px + 0.625rem); color: var(--ink-3); }

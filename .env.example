# Shopify Storefront API
# Get these from Shopify Admin > Settings > Apps > Develop apps > Create an app
# Give it Storefront API access, then copy the token
PUBLIC_SHOPIFY_STORE_DOMAIN=sunnyandranney.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token_here

# SOARD Stats API — JSON endpoint from the Sunshine on a Ranney Day site
# Used to pull live impact stats (room makeovers, children served, etc.)
SOARD_STATS_URL=https://your-soard-site.pages.dev/api/stats.json

# Google Maps JavaScript API
# Get from Google Cloud Console > APIs & Services > Credentials
# Restrict to: sunnyandranney.com/* and localhost:*
PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Google Places data — served by the hours-sync Cloudflare Worker, which
# fetches Google Places once daily and caches to D1 + CF Images. Build-time
# pages read from this URL instead of calling Google directly.
# Default: https://hours-sync.<your-subdomain>.workers.dev
PLACES_DATA_URL=https://hours-sync.example.workers.dev

# Kit — the footer signup adds people to Kit tagged "Sunny & Ranney".
# KIT_API_KEY is a v4 key (Kit → Settings → Developer), set as a secret in the
# Cloudflare dashboard: Pages → sunnyandranney-site → Settings → Variables.
KIT_API_KEY=your_kit_v4_api_key_here

# Staff admin (/admin) — set these in Cloudflare Pages, not here. Missing values
# deny everyone. See Cloudflare Zero Trust > Access > Applications.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=application-audience-tag
# ADMIN_MANAGER_EMAILS=manager@example.com,owner@example.com
# ADMIN_KIOSK_EMAILS=store-tablet@example.com
# ADMIN_OWNER_EMAILS=owner@example.com

# Gusto connection. Missing values turn it off.
# GUSTO_ENV must be exactly demo or production.
# GUSTO_ENV=demo
# GUSTO_TOKEN_KEY=   # openssl rand -base64 32
# MCP route, from scripts/gusto-mcp-register.mjs. Takes priority.
# GUSTO_MCP_CLIENT_ID=
# GUSTO_MCP_CLIENT_SECRET=
# Partner API route, from dev.gusto.com > Applications. Needs Gusto's approval.
# GUSTO_CLIENT_ID=
# GUSTO_CLIENT_SECRET=
